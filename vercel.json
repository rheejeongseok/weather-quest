{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/handler?route=:path*" }],
  "functions": { "api/handler.mjs": { "maxDuration": 30 } }
}
